# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
#
# Do NOT use the `postgres` superuser. Create a dedicated role that owns only
# this database — a compromised app credential should not be able to touch
# other databases or server configuration:
#
#   psql -U postgres -c "CREATE ROLE dmcrm_app LOGIN PASSWORD 'a-strong-password';"
#   psql -U postgres -c "CREATE DATABASE dmcrm OWNER dmcrm_app;"
#
# `dmcrm_app` owns the database so Prisma Migrate can create and alter tables.
# For a stricter production setup, split this into an owner role used only for
# migrations and a runtime role holding just SELECT/INSERT/UPDATE/DELETE.
#
# Percent-encode any reserved characters in the password: @ -> %40, : -> %3A,
# / -> %2F, ? -> %3F, # -> %23.
DATABASE_URL="postgresql://dmcrm_app:dmcrm_password@localhost:5432/dmcrm?schema=public"

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate a fresh one in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Seed credentials for the first administrator account (used by `npm run db:seed`).
# The password must be at least 10 characters.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Optional. Shared secret for the scheduled-job endpoints — currently the
# overdue invoice sweep at `POST /api/jobs/overdue-invoices`, which re-evaluates
# which invoices are past due (docs/01-data-model.md §3).
#
# Point any scheduler at that URL with `Authorization: Bearer <this value>`,
# once a day is plenty. Without it the endpoint refuses external callers
# outright rather than running unauthenticated, and an administrator can still
# run the sweep from the button on /invoices. Must be at least 16 characters
# if set; leaving it blank or commented out is fine.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# CRON_SECRET=""
