# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Replace YOUR_PASSWORD with the postgres superuser password you set during the
# PostgreSQL install. Create the database first with:
#   createdb -U postgres dmcrm
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dmcrm?schema=public"

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Seed credentials for the first administrator account (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@digimantra.com"
SEED_ADMIN_PASSWORD=""
